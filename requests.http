### ============================================================
### ASSETS
### ============================================================

### Get all assets
GET {{baseUrl}}/api/assets
Authorization: Bearer {{token}}

### Get asset by id
GET {{baseUrl}}/api/assets/1
Authorization: Bearer {{token}}

### Get assets by status
GET {{baseUrl}}/api/assets/status/OPERATIONAL
Authorization: Bearer {{token}}

### Get assets by location
GET {{baseUrl}}/api/assets/location/1
Authorization: Bearer {{token}}

### Create an asset
POST {{baseUrl}}/api/assets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "CNC Milling Machine",
  "assetCode": "AST-999",
  "category": "Machinery",
  "manufacturer": "Haas",
  "model": "VF-2",
  "serialNumber": "SN-12345",
  "purchaseDate": "2022-01-15",
  "status": "OPERATIONAL",
  "location": { "id": 1 }
}

### Update an asset
PUT {{baseUrl}}/api/assets/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Asset Name",
  "assetCode": "AST-001",
  "category": "Machinery",
  "manufacturer": "Haas",
  "model": "VF-2",
  "serialNumber": "SN-12345",
  "purchaseDate": "2022-01-15",
  "status": "UNDER_MAINTENANCE",
  "location": { "id": 1 }
}

### Delete an asset (ADMIN only)
DELETE {{baseUrl}}/api/assets/11
Authorization: Bearer {{token}}


### ============================================================
### WORK ORDERS
### ============================================================

### Get all work orders
GET {{baseUrl}}/api/work-orders
Authorization: Bearer {{token}}

### Get work order by id
GET {{baseUrl}}/api/work-orders/1
Authorization: Bearer {{token}}

### Get work orders by status
GET {{baseUrl}}/api/work-orders/status/OPEN
Authorization: Bearer {{token}}

### Get work orders by priority
GET {{baseUrl}}/api/work-orders/priority/HIGH
Authorization: Bearer {{token}}

### Get work orders by asset
GET {{baseUrl}}/api/work-orders/asset/1
Authorization: Bearer {{token}}

### Get work orders by technician
GET {{baseUrl}}/api/work-orders/technician/1
Authorization: Bearer {{token}}

### Create a work order
POST {{baseUrl}}/api/work-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Replace worn spindle bearing",
  "description": "Bearing showing signs of wear during inspection",
  "asset": { "id": 1 },
  "technician": { "id": 1 },
  "type": "CORRECTIVE",
  "priority": "HIGH",
  "dueDate": "2026-08-15"
}

### Update a work order
PUT {{baseUrl}}/api/work-orders/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Replace worn spindle bearing (updated)",
  "description": "Updated description",
  "type": "CORRECTIVE",
  "priority": "CRITICAL",
  "dueDate": "2026-08-20",
  "technician": { "id": 2 }
}

### Update work order status only
PATCH {{baseUrl}}/api/work-orders/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "COMPLETED"
}

### Delete a work order (ADMIN only)
DELETE {{baseUrl}}/api/work-orders/13
Authorization: Bearer {{token}}


### ============================================================
### MAINTENANCE SCHEDULES
### ============================================================

### Get all maintenance schedules
GET {{baseUrl}}/api/maintenance-schedules
Authorization: Bearer {{token}}

### Get schedule by id
GET {{baseUrl}}/api/maintenance-schedules/1
Authorization: Bearer {{token}}

### Get schedules by asset
GET {{baseUrl}}/api/maintenance-schedules/asset/1
Authorization: Bearer {{token}}

### Get schedules due now or overdue
GET {{baseUrl}}/api/maintenance-schedules/due
Authorization: Bearer {{token}}

### Create a maintenance schedule
POST {{baseUrl}}/api/maintenance-schedules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "asset": { "id": 1 },
  "frequency": "MONTHLY",
  "description": "Routine monthly inspection",
  "lastMaintenanceDate": "2026-07-01",
  "nextMaintenanceDate": "2026-08-01",
  "active": true
}

### Update a maintenance schedule
PUT {{baseUrl}}/api/maintenance-schedules/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "frequency": "QUARTERLY",
  "description": "Updated maintenance plan",
  "lastMaintenanceDate": "2026-07-01",
  "nextMaintenanceDate": "2026-10-01",
  "active": true
}

### Delete a maintenance schedule (ADMIN only)
DELETE {{baseUrl}}/api/maintenance-schedules/7
Authorization: Bearer {{token}}


