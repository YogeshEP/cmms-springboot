# Copy this file to .env and adjust values as needed.
# docker-compose reads these automatically.

POSTGRES_DB=cmms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

APP_PORT=8080

# IMPORTANT: change this for anything beyond local/demo use
JWT_SECRET=cmms-super-secret-key-change-this-in-production-env-1234567890
JWT_EXPIRATION_MS=86400000

# Set to false to stop re-seeding sample data on every fresh DB
CMMS_SEED_ENABLED=true
